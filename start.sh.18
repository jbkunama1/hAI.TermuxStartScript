#!/data/data/com.termux/files/usr/bin/bash

# =========================================================
# LLM Control Center (Termux + whiptail)
# Dienste: sshd, cloudflared, llama.cpp (llama-server), feroxbuster
# + Watchtower (llama_watchdog.sh): startet llama-server neu,
#   wenn er gestoppt/abgestuerzt ist
# + API-Key-Verwaltung und Watchtower-Einstellungen
#   (Modell, Binary, Host, Port, Kontext, Threads)
# =========================================================

# --- Pfade zu deinen Scripts ---
LLAMA_MGR="$HOME/start-llama-server.sh" # dein großes Management-Script
FEROX_SCRIPT="$HOME/feroxbuster_start_v2.sh" # ggf. anpassen: feroxbuster_start_v2.sh
WATCHDOG_SCRIPT="$HOME/llama_watchdog.sh"  # Watchtower (muss in $HOME liegen)

SSHD_LOG="$HOME/sshd.log"
CF_LOG="$HOME/cloudflared.log"

# Cloudflare-Tunnel-Befehl (aus start_cl_llama-6.sh)
# HINWEIS: Token hier lokal eintragen (nicht ins Repo committen!)
CF_CMD="cloudflared tunnel run --token DEIN_CLOUDFLARE_TOKEN_HIER"

# --- Watchtower-Defaults (im Menue aenderbar) ---
LLAMA_BIN="$HOME/llama.cpp/build/bin/llama-server"
MODEL_PATH="$HOME/models/Qwen2.5-3B-Instruct/Qwen2.5-3B-Instruct-Q4_0_4_4.gguf"
HOST="192.168.178.18"
PORT=8080
CTX_SIZE=6666
THREADS=6

LLAMA_LOG="$HOME/llama-server.log"
WATCHDOG_LOG="$HOME/llama-watchdog.log"

# Konfig-Dateien (lokal, nie im Repo)
API_KEY_FILE="$HOME/.config/my-services/llama-api.key"
WATCHDOG_CONF="$HOME/.config/my-services/llama-watchdog.conf"

mkdir -p "$HOME/.config/my-services"

# Gespeicherte Watchtower-Einstellungen laden (ueberschreibt Defaults)
if [ -f "$WATCHDOG_CONF" ]; then
  . "$WATCHDOG_CONF"
fi

# --- Hilfsfunktionen ---

msg_box() {
  local text="$1"
  whiptail --title "LLM Control Center" --msgbox "$text" 12 70
}

confirm_box() {
  local text="$1"
  whiptail --title "Bestätigen" --yesno "$text" 10 70
}

input_box() {
  local title="$1" text="$2" current="$3"
  whiptail --title "$title" --inputbox "$text" 10 76 "$current" 3>&1 1>&2 2>&3
}

# ---------------- sshd ----------------

start_sshd() {
  if pgrep -x sshd >/dev/null 2>&1; then
    msg_box "sshd läuft bereits."
    return 0
  fi

  termux-wake-lock 2>/dev/null || true
  nohup sshd -D >"$SSHD_LOG" 2>&1 &
  sleep 1

  if pgrep -x sshd >/dev/null 2>&1; then
    msg_box "sshd gestartet.\nLog: $SSHD_LOG"
  else
    msg_box "Fehler: sshd konnte nicht gestartet werden."
  fi
}

stop_sshd() {
  if ! pgrep -x sshd >/dev/null 2>&1; then
    msg_box "sshd läuft nicht."
    return 0
  fi

  confirm_box "sshd wirklich stoppen?"
  if [ $? -eq 0 ]; then
    pkill -x sshd 2>/dev/null || true
    msg_box "sshd gestoppt."
  fi
}

restart_sshd() {
  stop_sshd
  start_sshd
}

status_sshd() {
  if pgrep -x sshd >/dev/null 2>&1; then
    msg_box "sshd Status:\n\nLÄUFT\n\nLog: $SSHD_LOG"
  else
    msg_box "sshd Status:\n\nGESTOPPT\n\nLog: $SSHD_LOG"
  fi
}

# ---------------- cloudflared ----------------

start_cloudflare() {
  if pgrep -f "cloudflared tunnel run" >/dev/null 2>&1; then
    msg_box "cloudflared läuft bereits."
    return 0
  fi

  nohup $CF_CMD >"$CF_LOG" 2>&1 &
  sleep 2

  if pgrep -f "cloudflared tunnel run" >/dev/null 2>&1; then
    msg_box "cloudflared Tunnel gestartet.\nLog: $CF_LOG"
  else
    msg_box "Fehler: cloudflared konnte nicht gestartet werden."
  fi
}

stop_cloudflare() {
  if ! pgrep -f "cloudflared tunnel run" >/dev/null 2>&1; then
    msg_box "cloudflared läuft nicht."
    return 0
  fi

  confirm_box "cloudflared Tunnel wirklich stoppen?"
  if [ $? -eq 0 ]; then
    pkill -f "cloudflared tunnel run" 2>/dev/null || true
    msg_box "cloudflared gestoppt."
  fi
}

restart_cloudflare() {
  stop_cloudflare
  start_cloudflare
}

status_cloudflare() {
  if pgrep -f "cloudflared tunnel run" >/dev/null 2>&1; then
    msg_box "cloudflared Status:\n\nLÄUFT\n\nLog: $CF_LOG"
  else
    msg_box "cloudflared Status:\n\nGESTOPPT\n\nLog: $CF_LOG"
  fi
}

# ---------------- API-Key (llama-server) ----------------

api_key_set() {
  [ -f "$API_KEY_FILE" ] && [ -s "$API_KEY_FILE" ]
}

offer_restart_for_change() {
  if pgrep -f "$LLAMA_BIN" >/dev/null 2>&1; then
    confirm_box "llama-server läuft noch mit den alten Werten.\nJetzt neu starten, damit die Änderung greift?"
    if [ $? -eq 0 ]; then
      pkill -f "$LLAMA_BIN" 2>/dev/null || true
      sleep 1
      if watchdog_running; then
        msg_box "Server gestoppt – Watchtower startet ihn\ngleich mit den neuen Werten neu."
      else
        msg_box "Server gestoppt.\nStarte ihn neu (Punkt 1 oder Watchtower AN)."
      fi
    fi
  fi
}

set_api_key_terminal() {
  clear
  echo "llama-server API-Key eingeben"
  echo "----------------------------------------"
  echo "Der Key wird lokal gespeichert (chmod 600) und vom"
  echo "Watchdog beim (Neu-)Start als --api-key übergeben."
  echo "Die Eingabe wird NICHT angezeigt."
  echo ""
  printf "API-Key: "
  read -rs apikey
  echo ""

  if [ -n "$apikey" ]; then
    printf '%s' "$apikey" > "$API_KEY_FILE"
    chmod 600 "$API_KEY_FILE"
    msg_box "API-Key gespeichert."
    offer_restart_for_change
  else
    msg_box "Leere Eingabe – nichts gespeichert."
  fi
}

show_api_key_status() {
  if api_key_set; then
    msg_box "API-Key ist gespeichert.\n\nDatei: $API_KEY_FILE"
  else
    msg_box "API-Key ist nicht gesetzt.\n\nDer Server läuft ohne Authentifizierung."
  fi
}

delete_api_key() {
  if ! api_key_set; then
    msg_box "Es ist kein API-Key gespeichert."
    return 0
  fi

  confirm_box "API-Key wirklich löschen?\n\nDer Server läuft danach ohne Authentifizierung."
  if [ $? -eq 0 ]; then
    rm -f "$API_KEY_FILE"
    msg_box "API-Key gelöscht."
    offer_restart_for_change
  fi
}

# ---------------- Watchtower-Einstellungen ----------------

save_watchdog_conf() {
  cat > "$WATCHDOG_CONF" <<CONF
LLAMA_BIN="$LLAMA_BIN"
MODEL_PATH="$MODEL_PATH"
HOST="$HOST"
PORT=$PORT
CTX_SIZE=$CTX_SIZE
THREADS=$THREADS
CONF
  chmod 600 "$WATCHDOG_CONF"
}

choose_model() {
  local models
  models=$(find "$HOME/models" "$HOME" -maxdepth 5 -name "*.gguf" -type f 2>/dev/null | sort -u)

  if [ -z "$models" ]; then
    msg_box "Keine .gguf-Modelle gefunden.\n\nBitte Pfad manuell eintragen."
    local manual
    manual=$(input_box "Modell" "Pfad zur .gguf-Datei:" "$MODEL_PATH") || return 0
    [ -n "$manual" ] && MODEL_PATH="$manual" && save_watchdog_conf && msg_box "Modell gespeichert." && offer_restart_for_change
    return 0
  fi

  local -a items=()
  local i=1 f
  while IFS= read -r f; do
    items+=("$i" "${f#$HOME/}")
    i=$((i+1))
  done <<< "$models"
  items+=("M" "Pfad manuell eingeben")

  local choice
  choice=$(whiptail --title "Modell wählen" --menu \
    "Gefundene .gguf-Modelle (aktuell: ${MODEL_PATH#$HOME/}):" \
    24 90 15 "${items[@]}" 3>&1 1>&2 2>&3) || return 0

  if [ "$choice" = "M" ]; then
    local manual
    manual=$(input_box "Modell" "Pfad zur .gguf-Datei:" "$MODEL_PATH") || return 0
    [ -n "$manual" ] && MODEL_PATH="$manual"
  else
    MODEL_PATH=$(printf '%s\n' "$models" | sed -n "${choice}p")
  fi

  save_watchdog_conf
  msg_box "Modell gespeichert:\n\n$MODEL_PATH"
  offer_restart_for_change
}

choose_binary() {
  local bins
  bins=$(find "$HOME/llama.cpp" "$PREFIX/bin" -maxdepth 5 -name "llama-server" -type f 2>/dev/null | sort -u)

  if [ -z "$bins" ]; then
    msg_box "Keine llama-server-Binary gefunden.\n\nBitte Pfad manuell eintragen."
    local manual
    manual=$(input_box "Binary" "Pfad zur llama-server-Binary:" "$LLAMA_BIN") || return 0
    [ -n "$manual" ] && LLAMA_BIN="$manual" && save_watchdog_conf && msg_box "Binary gespeichert." && offer_restart_for_change
    return 0
  fi

  local -a items=()
  local i=1 f
  while IFS= read -r f; do
    items+=("$i" "${f#$HOME/}")
    i=$((i+1))
  done <<< "$bins"
  items+=("M" "Pfad manuell eingeben")

  local choice
  choice=$(whiptail --title "Server-Binary wählen" --menu \
    "Gefundene llama-server-Binaries (aktuell: ${LLAMA_BIN#$HOME/}):" \
    24 90 15 "${items[@]}" 3>&1 1>&2 2>&3) || return 0

  if [ "$choice" = "M" ]; then
    local manual
    manual=$(input_box "Binary" "Pfad zur llama-server-Binary:" "$LLAMA_BIN") || return 0
    [ -n "$manual" ] && LLAMA_BIN="$manual"
  else
    LLAMA_BIN=$(printf '%s\n' "$bins" | sed -n "${choice}p")
  fi

  save_watchdog_conf
  msg_box "Binary gespeichert:\n\n$LLAMA_BIN"
  offer_restart_for_change
}

edit_host() {
  local v
  v=$(input_box "Host" "Adresse, auf der der Server lauscht:" "$HOST") || return 0
  [ -z "$v" ] && return 0
  HOST="$v"
  save_watchdog_conf
  msg_box "Host gespeichert: $HOST"
  offer_restart_for_change
}

edit_port() {
  local v
  v=$(input_box "Port" "Port für den Server:" "$PORT") || return 0
  [ -z "$v" ] && return 0
  PORT="$v"
  save_watchdog_conf
  msg_box "Port gespeichert: $PORT"
  offer_restart_for_change
}

edit_ctx() {
  local v
  v=$(input_box "Kontextgröße" "Kontextgröße (-c):" "$CTX_SIZE") || return 0
  [ -z "$v" ] && return 0
  CTX_SIZE="$v"
  save_watchdog_conf
  msg_box "Kontextgröße gespeichert: $CTX_SIZE"
  offer_restart_for_change
}

edit_threads() {
  local v
  v=$(input_box "Threads" "Anzahl Threads (-t):" "$THREADS") || return 0
  [ -z "$v" ] && return 0
  THREADS="$v"
  save_watchdog_conf
  msg_box "Threads gespeichert: $THREADS"
  offer_restart_for_change
}

show_watchdog_conf() {
  msg_box "Aktuelle Watchtower-Konfiguration:\n\nModell:  $MODEL_PATH\nBinary:  $LLAMA_BIN\nHost:    $HOST\nPort:    $PORT\nKontext: $CTX_SIZE\nThreads: $THREADS\n\nDatei: $WATCHDOG_CONF"
}

settings_menu() {
  while true; do
    local SCHOICE
    SCHOICE=$(whiptail --title "Watchtower Einstellungen" --menu \
      "Werte für den (Neu-)Start von llama-server:" \
      24 80 14 \
      "1" "Modell wählen (Scan .gguf)" \
      "2" "Server-Binary wählen (Scan)" \
      "3" "Host ändern (aktuell: $HOST)" \
      "4" "Port ändern (aktuell: $PORT)" \
      "5" "Kontextgröße ändern (aktuell: $CTX_SIZE)" \
      "6" "Threads ändern (aktuell: $THREADS)" \
      "7" "Aktuelle Konfiguration anzeigen" \
      "8" "Zurück" \
      3>&1 1>&2 2>&3)

    local EXIT_STATUS=$?
    [ $EXIT_STATUS -ne 0 ] && break

    case "$SCHOICE" in
      "1") choose_model ;;
      "2") choose_binary ;;
      "3") edit_host ;;
      "4") edit_port ;;
      "5") edit_ctx ;;
      "6") edit_threads ;;
      "7") show_watchdog_conf ;;
      "8") break ;;
      *) msg_box "Ungültige Auswahl." ;;
    esac
  done
}

# ---------------- Watchtower (llama_watchdog.sh) ----------------

watchdog_running() {
  pgrep -f "llama_watchdog.sh" >/dev/null 2>&1
}

start_watchdog() {
  if watchdog_running; then
    msg_box "Watchtower läuft bereits."
    return 0
  fi

  if [ ! -f "$WATCHDOG_SCRIPT" ]; then
    msg_box "Fehler: Watchdog-Skript nicht gefunden:\n$WATCHDOG_SCRIPT\n\nBitte llama_watchdog.sh nach \$HOME legen."
    return 1
  fi

  termux-wake-lock 2>/dev/null || true
  nohup bash "$WATCHDOG_SCRIPT" >/dev/null 2>&1 &
  sleep 1

  if watchdog_running; then
    msg_box "Watchtower AN.\n\nllama-server wird überwacht und bei\nStopp automatisch neu gestartet.\n\nLog: $WATCHDOG_LOG"
  else
    msg_box "Fehler: Watchtower konnte nicht gestartet werden."
  fi
}

stop_watchdog() {
  if ! watchdog_running; then
    msg_box "Watchtower läuft nicht."
    return 0
  fi

  confirm_box "Watchtower wirklich ausschalten?\n\nllama-server läuft weiter, wird aber\nNICHT mehr automatisch neu gestartet."
  if [ $? -eq 0 ]; then
    pkill -f "llama_watchdog.sh" 2>/dev/null || true
    msg_box "Watchtower AUS."
  fi
}

status_watchdog() {
  if watchdog_running; then
    msg_box "Watchtower Status:\n\nAN\n\nLog: $WATCHDOG_LOG"
  else
    msg_box "Watchtower Status:\n\nAUS"
  fi
}

watchtower_menu() {
  while true; do
    local WCHOICE
    WCHOICE=$(whiptail --title "Watchtower (llama-server)" --menu \
      "Überwachung, API-Key und Einstellungen verwalten:" \
      24 80 14 \
      "1" "Watchtower AN (Server überwachen)" \
      "2" "Watchtower AUS" \
      "3" "Watchtower Status" \
      "4" "API-Key eingeben (Terminal)" \
      "5" "API-Key Status" \
      "6" "API-Key löschen" \
      "7" "Einstellungen (Modell, Host, Port, Kontext)" \
      "8" "Zurück" \
      3>&1 1>&2 2>&3)

    local EXIT_STATUS=$?
    [ $EXIT_STATUS -ne 0 ] && break

    case "$WCHOICE" in
      "1") start_watchdog ;;
      "2") stop_watchdog ;;
      "3") status_watchdog ;;
      "4") set_api_key_terminal ;;
      "5") show_api_key_status ;;
      "6") delete_api_key ;;
      "7") settings_menu ;;
      "8") break ;;
      *) msg_box "Ungültige Auswahl." ;;
    esac
  done
}

# ---------------- llama-server ----------------

start_llama_mgr() {
  if [ ! -x "$LLAMA_MGR" ]; then
    msg_box "Fehler: llama.cpp-Verwaltung nicht ausführbar:\n$LLAMA_MGR"
    return 1
  fi

  bash "$LLAMA_MGR"
}

stop_llama_server() {
  if ! pgrep -f "$LLAMA_BIN" >/dev/null 2>&1; then
    msg_box "llama-server läuft nicht."
    return 0
  fi

  if watchdog_running; then
    confirm_box "ACHTUNG: Watchtower ist AN!\n\nEr würde llama-server sofort neu starten.\nWatchtower ausschalten und Server stoppen?"
    if [ $? -eq 0 ]; then
      pkill -f "llama_watchdog.sh" 2>/dev/null || true
    else
      return 0
    fi
  fi

  confirm_box "llama-server wirklich stoppen?"
  if [ $? -eq 0 ]; then
    pkill -f "$LLAMA_BIN" 2>/dev/null || true
    termux-wake-unlock 2>/dev/null || true
    msg_box "llama-server gestoppt."
  fi
}

restart_llama_server() {
  stop_llama_server
  start_llama_mgr
}

status_llama_server() {
  if pgrep -f "$LLAMA_BIN" >/dev/null 2>&1; then
    msg_box "llama-server Status:\n\nLÄUFT\n\nLog: $LLAMA_LOG"
  else
    msg_box "llama-server Status:\n\nGESTOPPT\n\nLog: $LLAMA_LOG"
  fi
}

# ---------------- feroxbuster ----------------

start_ferox() {
  local script="$FEROX_SCRIPT"
  if [ ! -x "$script" ]; then
    msg_box "Fehler: feroxbuster-Script nicht ausführbar:\n$script"
    return 1
  fi

  bash "$script"
}

# ---------------- Gesamt-Status ----------------

show_status() {
  local s_ssh s_cf s_llm s_wd s_key

  if pgrep -x sshd >/dev/null 2>&1; then s_ssh="LÄUFT"; else s_ssh="GESTOPPT"; fi
  if pgrep -f "cloudflared tunnel run" >/dev/null 2>&1; then s_cf="LÄUFT"; else s_cf="GESTOPPT"; fi
  if pgrep -f "$LLAMA_BIN" >/dev/null 2>&1; then s_llm="LÄUFT"; else s_llm="GESTOPPT"; fi
  if watchdog_running; then s_wd="AN"; else s_wd="AUS"; fi
  if api_key_set; then s_key="gespeichert"; else s_key="nicht gesetzt"; fi

  msg_box "Gesamtstatus:\n\nsshd: $s_ssh\ncloudflared: $s_cf\nllama-server: $s_llm\nWatchtower: $s_wd\nAPI-Key: $s_key\n\nModell: ${MODEL_PATH#$HOME/}\n$HOST:$PORT (ctx $CTX_SIZE)\n\nsshd-Log: $SSHD_LOG\nCF-Log: $CF_LOG\nllama-Log: $LLAMA_LOG"
}

# ---------------- Untermenü Netzwerk ----------------

network_menu() {
  while true; do
    local NCHOICE
    NCHOICE=$(whiptail --title "Netzwerk (sshd & cloudflared)" --menu \
      "Verwalte SSH und Cloudflare-Tunnel:" \
      20 80 10 \
      "1" "sshd starten" \
      "2" "sshd stoppen" \
      "3" "sshd neustarten" \
      "4" "sshd Status" \
      "5" "cloudflared starten" \
      "6" "cloudflared stoppen" \
      "7" "cloudflared neustarten" \
      "8" "cloudflared Status" \
      "9" "Zurück" \
      3>&1 1>&2 2>&3)

    local EXIT_STATUS=$?
    [ $EXIT_STATUS -ne 0 ] && break

    case "$NCHOICE" in
      "1") start_sshd ;;
      "2") stop_sshd ;;
      "3") restart_sshd ;;
      "4") status_sshd ;;
      "5") start_cloudflare ;;
      "6") stop_cloudflare ;;
      "7") restart_cloudflare ;;
      "8") status_cloudflare ;;
      "9") break ;;
      *) msg_box "Ungültige Auswahl." ;;
    esac
  done
}

# --- Kein automatischer Start von sshd/cloudflared (Option 1) ---
# dein bestehender Autostart bleibt aktiv
# start_sshd
# start_cloudflare

# ---------------- Hauptmenü ----------------

while true; do
  CHOICE=$(whiptail --title "LLM Control Center" --menu \
    "Verwalte Dienste und Tools:" \
    24 80 14 \
    "1" "llama.cpp Verwaltung öffnen (start-llama-server-3.sh)" \
    "2" "feroxbuster starten" \
    "3" "Gesamtstatus anzeigen" \
    "4" "Netzwerk: sshd & cloudflared" \
    "5" "llama-server stoppen" \
    "6" "llama-server neustarten (über Verwaltung)" \
    "7" "llama-server Status" \
    "8" "Watchtower (Überwachung + API-Key + Einstellungen)" \
    "9" "Beenden" \
    3>&1 1>&2 2>&3)

  EXIT_STATUS=$?
  [ $EXIT_STATUS -ne 0 ] && break

  case "$CHOICE" in
    "1") start_llama_mgr ;;
    "2") start_ferox ;;
    "3") show_status ;;
    "4") network_menu ;;
    "5") stop_llama_server ;;
    "6") restart_llama_server ;;
    "7") status_llama_server ;;
    "8") watchtower_menu ;;
    "9") break ;;
    *) msg_box "Ungültige Auswahl." ;;
  esac
done

exit 0
